{
  "name": "nostr-vault-web-relay",
  "version": "0.1.0",
  "description": "Nostr relay that runs in a browser page (PWA), served from nostrvault.app/relay/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "npm run build && PORT=8787 node server.mjs",
    "test": "node --test test/"
  },
  "type": "module",
  "dependencies": {
    "@fips/core": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.56/fips-core-0.0.52.tgz",
    "@fips/tcp": "https://github.com/mmalmi/fips-tcp/releases/download/fips-tcp-v0.2.5/fips-tcp-0.2.4.tgz",
    "@fips/transport-webrtc": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.56/fips-transport-webrtc-0.0.55.tgz",
    "@fips/transport-websocket": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.56/fips-transport-websocket-0.0.10.tgz",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "eventemitter3": "^5.0.4",
    "nostr-tools": "^2.25.2",
    "uuid": "^14.0.3"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
