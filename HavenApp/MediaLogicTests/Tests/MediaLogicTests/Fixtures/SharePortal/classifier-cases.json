  {
   "name": "two photos",
   "input": {
    "files": [
     {
      "mime": "image/jpeg",
      "name": "a.jpg"
     },
     {
      "mime": "image/heic",
      "name": "b.heic"
     }
    ]
   },
   "expect": [
    "upload",
    "media_post"
   ]
  },
  {
   "name": "photo and video",
   "input": {
    "files": [
     {
      "mime": "image/png",
      "name": "a.png"
     },
     {
      "mime": "video/quicktime",
      "name": "b.mov"
     }
    ]
   },
   "expect": [
    "upload",
    "media_post"
   ]
  },
  {
   "name": "pdf",
   "input": {
    "files": [
     {
      "mime": "application/pdf",
      "name": "paper.pdf"
     }
    ]
   },
   "expect": [
