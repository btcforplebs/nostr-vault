{
 "clip": [
  {
   "name": "title, url and selection",
   "input": {
    "title": "A Post",
    "url": "https://example.com/post",
    "selection": "First line.\n\nSecond line."
   },
   "expect": {
    "title": "A Post",
    "body": "> First line.\n>\n> Second line.\n\nSource: [A Post](https://example.com/post)"
   }
  },
  {
   "name": "no selection",
   "input": {
    "title": "A Post",
    "url": "https://example.com/post",
    "selection": null
   },
   "expect": {
    "title": "A Post",
    "body": "Source: [A Post](https://example.com/post)"
   }
  },
  {
   "name": "no title falls back to host",
   "input": {
    "title": "  ",
    "url": "https://www.Example.com/x",
    "selection": "Quote"
   },
   "expect": {
    "title": "www.example.com",
    "body": "> Quote\n\nSource: [www.example.com](https://www.Example.com/x)"
   }
  },
  {
   "name": "brackets and parens are escaped",
   "input": {
    "title": "Big [news] \\ today",
    "url": "https://e.com/a (b)/c",
    "selection": null
   },
   "expect": {
    "title": "Big [news] \\ today",
    "body": "Source: [Big \\[news\\] \\\\ today](https://e.com/a%20%28b%29/c)"
   }
  },
  {
   "name": "no url, text only",
   "input": {
    "title": null,
    "url": null,
    "selection": "Just words"
   },
   "expect": {
    "title": "Clipped link",
    "body": "> Just words"
   }
  }
 ],
