# Nostr Vault for Linux, native: the mesh (nv-mesh, the engine the Mac app runs, with the Mac's options). Own uid:
# the box's mesh key ($NV_DATA_DIR/mesh/key/) is readable by this program alone, never by the vault. Never the
# owner's key. Strangers reach only the capped mesh door; own devices (from the owner's 10063) reach the vault.
[Unit]
Description=Nostr Vault mesh
Documentation=https://github.com/btcforplebs/nostr-vault/tree/master/linux/mesh
After=network-online.target nostr-vault-prepare.service
Requires=nostr-vault-prepare.service
PartOf=nostr-vault.service
ConditionPathExists=/etc/nostr-vault/vault.env

[Service]
Type=simple
User=nvmesh
Group=nvmesh
Environment=NV_DATA_DIR=/var/lib/nostr-vault NV_PORT=8080 NV_MESH_DOOR_PORT=8081
EnvironmentFile=/etc/nostr-vault/vault.env
ExecStart=/usr/lib/nostr-vault/nv-mesh
Restart=always
RestartSec=2
Nice=10
MemoryMax=512M
CPUWeight=25
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# /run/nv-mesh (made by prepare): dial.sock, which the vault uses to dial out.
ReadWritePaths=-/var/lib/nostr-vault/mesh -/run/nv-mesh

[Install]
WantedBy=multi-user.target
