#!/bin/sh
# Run as root by nostr-vault-prepare.service before the vault and the mesh start: the native twin of what
# supervise.sh does in the container. Only the two top folders are set; the rest is left as the programs made it.
# A data dir brought over from the Docker box (same uids, 10002 and 10001) needs nothing more. If the users got other
# uids here, the folders the container's users owned are handed to ours, once.
set -eu
: "${NV_DATA_DIR:=/var/lib/nostr-vault}"
die() { echo "prepare: $*" >&2; exit 1; }
case "$NV_DATA_DIR" in /*) ;; *) die "NV_DATA_DIR must be a full path" ;; esac
[ -L "$NV_DATA_DIR" ] && die "$NV_DATA_DIR is a symlink; give the real path"
vault=$(id -u nvvault) || die "no nvvault user (reinstall nostr-vault)"
mesh=$(id -u nvmesh) || die "no nvmesh user (reinstall nostr-vault)"

mkdir -p "$NV_DATA_DIR"
# A Docker box's data under other uids than ours: hand it over (vault's files to nvvault, mesh/ to nvmesh).
cur=$(stat -c %u "$NV_DATA_DIR")
if [ "$cur" != "$vault" ] && [ "$cur" != 0 ]; then
  echo "prepare: $NV_DATA_DIR belongs to uid $cur; giving it to nvvault ($vault)" >&2
  find "$NV_DATA_DIR" -xdev -path "$NV_DATA_DIR/mesh" -prune -o -user "$cur" -exec chown -h "$vault:$vault" {} +
fi
chown "$vault:$vault" "$NV_DATA_DIR" && chmod 711 "$NV_DATA_DIR"
mkdir -p "$NV_DATA_DIR/mesh"
cur=$(stat -c %u "$NV_DATA_DIR/mesh")
if [ "$cur" != "$mesh" ]; then
  echo "prepare: $NV_DATA_DIR/mesh belongs to uid $cur; giving it to nvmesh ($mesh)" >&2
  chown -hR "$mesh:$mesh" "$NV_DATA_DIR/mesh"
fi
chmod 755 "$NV_DATA_DIR/mesh"
