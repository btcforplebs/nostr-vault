#!/bin/sh
# nostr-vault postinst: the two users (the container's uids when they are free, so a Docker box's data dir works as
# it is), the desktop caches, and (when the vault is set up) the services, started again on the new version.
set -e
user() { # user <name> <uid>
  getent passwd "$1" >/dev/null && return
  if getent passwd "$2" >/dev/null || getent group "$2" >/dev/null; then
    useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$1"
  else
    useradd --system --uid "$2" --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$1"
  fi
}
if [ "$1" = configure ]; then
  user nvmesh 10001
  user nvvault 10002
  # SELinux on (Fedora): label the programs as programs, so systemd runs them as unconfined_service_t, not init_t.
  if command -v selinuxenabled >/dev/null && selinuxenabled && command -v semodule >/dev/null; then
    semodule -i /usr/share/nostr-vault/selinux/nostr-vault.cil && restorecon -F /usr/lib/nostr-vault/* \
      || echo "nostr-vault: couldn't install its SELinux labels; it runs, in systemd's own domain" >&2
  fi
  if command -v gtk-update-icon-cache >/dev/null; then gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true; fi
  if command -v update-desktop-database >/dev/null; then update-desktop-database -q /usr/share/applications || true; fi
  # A window or tray still running the old version: SIGUSR2 starts it over on the new one (nv_paint.py); an older
  # one has no handler for it and quits, so nobody keeps an old window (beta 9's stayed up, and a newer install, or
  # the Flatpak, opened in it). Open Nostr Vault again from your apps then.
  if command -v pkill >/dev/null; then
    # /usr/sbin too: on Fedora and Arch it is /usr/bin under another name, first on PATH, so a launcher's
    # "nostr-vault-desktop" runs as /usr/sbin/nostr-vault-desktop.
    pkill -USR2 -f '^(/usr)?/s?bin/python3(\.[0-9]+)? -I (/usr)?/s?bin/nostr-vault-desktop( |$)' || true
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    if grep -q '^NV_OWNER=npub1' /etc/nostr-vault/vault.env 2>/dev/null; then
      systemctl enable -q nostr-vault.service nostr-vault-mesh.service || true
      systemctl restart nostr-vault-prepare.service nostr-vault.service nostr-vault-mesh.service || true
    else
      echo "Nostr Vault is installed. Set it up: open Nostr Vault from your apps, or run"
      echo "  sudo nostr-vault-setup --owner npub1…"
    fi
  fi
fi
exit 0
