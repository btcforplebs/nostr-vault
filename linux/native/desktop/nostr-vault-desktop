Indicator = None
for _name, _ver in (("AyatanaAppIndicator3", "0.1"), ("AppIndicator3", "0.1")):
    try:
        gi.require_version(_name, _ver)
        Indicator = getattr(__import__("gi.repository", fromlist=[_name]), _name)
        break
    except (ValueError, ImportError):
        pass

APP_ID = "app.nostrvault.Desktop"
ENV_FILE = "/etc/nostr-vault/vault.env"
SHARE = os.environ.get("NV_DESKTOP_SHARE", "/usr/share/nostr-vault/desktop")
SETUP = "/usr/bin/nostr-vault-setup"
# Inside a Flatpak the window runs the vault itself (nv_flatpak.py): no systemd, no pkexec, settings and data in the
# app's own folders. The .deb never ships nv_flatpak.py and never takes this path.
FLATPAK = os.path.exists("/.flatpak-info")
fp = None
if FLATPAK:
    sys.path.insert(0, SHARE)
    import nv_flatpak as fp  # noqa: E402

    ENV_FILE = fp.env_file()
    SUPERVISOR = fp.Supervisor()
ICON = fp.APP_ID if fp else "nostr-vault"
TRAY_ICON = fp.APP_ID + "-tray" if fp else "nostr-vault-tray"  # a Flatpak exports only icons named after its ID
ROUTES = {  # the Mac app's tabs, as the web app's routes
    "feed": "#/feed",
    "vault": "#/vault",
    "devices": "#/box",
    "settings": "#/settings",
    "compose": "#/compose",
}
BG = "#000000"
# Added to WebKit's user agent, so the web app in this window posts as "Nostr Vault on Linux" (web-vault's
# client-tag.js looks for this word; a plain browser has none and stays "on Web").
UA_MARK = "NostrVaultLinux"
# A page whose web process ends again within this many seconds of the last crash page is crashing on every page (a GPU
# driver that kills each renderer, say): stop loading pages and show the crash page drawn by GTK, which needs no web
# process, instead of starting one renderer after another.
CRASH_LOOP_S = 5
# The main loop is "stalled" when its heartbeat is this late: the window then writes where its main thread is to its
# log (the compositor calls a window that doesn't answer for a few seconds "not responding").
STALL_S = 2.0
# After the window closes, the app starts over as the tray alone this many seconds later (restart_as_tray).
RESTART_AFTER_CLOSE_S = 3
LOG_MAX = 256 * 1024  # window.log is cut back to its newest half past this size


def log_path():
    return os.path.join(GLib.get_user_cache_dir(), "nostr-vault-desktop", "window.log")


def log(text):
    """A line to stderr and to the window's log (~/.cache/nostr-vault-desktop/window.log): a window started from a
    launcher has no terminal, so its stderr goes nowhere anyone can read."""
    line = time.strftime("%Y-%m-%dT%H:%M:%S ") + text
    print("nostr-vault-desktop: " + text, file=sys.stderr, flush=True)
    try:
        path = log_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
            with open(path, "rb") as f:
                f.seek(-LOG_MAX // 2, os.SEEK_END)
                keep = f.read()
            with open(path, "wb") as f:
                f.write(keep)
        with open(path, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def webkit_version():
    return (WebKit2.get_major_version(), WebKit2.get_minor_version(), WebKit2.get_micro_version())


# WebKitGTK 2.54.0 and 2.54.1 crash the whole window (SIGSEGV) when they paste from an empty clipboard: GTK answers
# "no targets" with a NULL list and a count of -1, and Clipboard::formats() reads that as a list of 2^64 entries.
# Fixed in 2.54.2 (WebKit 75cdc5a66f, https://bugs.webkit.org/show_bug.cgi?id=324466), but distros that pin a snapshot
# still ship 2.54.1 (on 2026-11-20 Omarchy's stable mirror was a snapshot of 2026-10-22). On those versions the window
# doesn't let a paste reach WebKit while the clipboard (or, for a middle click, the primary selection) is empty:
# Ctrl+V, Ctrl+Shift+V, Shift+Insert, a middle click in a text field and the right-click menu's Paste. What's on each
# is kept up to date without waiting (a GTK "owner-change" starts an asynchronous TARGETS request), so the check never
# blocks the window.
PASTE_GUARD = (2, 54, 0) <= webkit_version() < (2, 54, 2)


def keycodes_of(*keyvals):
    """The hardware keycodes that give any of these keyvals in any of the keyboard's layouts (groups)."""
    keymap = Gdk.Keymap.get_for_display(Gdk.Display.get_default()) if Gdk.Display.get_default() else None
    codes = set()
    for kv in keyvals if keymap else ():
        ok, keys = keymap.get_entries_for_keyval(kv)
        if ok:
            codes.update(k.keycode for k in keys)
    return codes


def read_env(path=ENV_FILE):
    """vault.env as a dict (KEY=value lines; it holds an npub and paths, no secrets)."""
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return out


def vault_port(env):
    try:
        p = int(env.get("NV_PORT", "8080"))
        return p if 0 < p < 65536 else 8080
    except ValueError:
        return 8080


def mesh_status(env):
    """The mesh's status.json (written every 5 s by nv-mesh, world-readable), or {}."""
    path = os.path.join(env.get("NV_DATA_DIR", "/var/lib/nostr-vault"), "mesh", "status.json")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def box_npub(env):
    path = os.path.join(env.get("NV_DATA_DIR", "/var/lib/nostr-vault"), "mesh", "npub")
    try:
        with open(path, encoding="utf-8") as f:
            s = f.read().strip()
            return s if s.startswith("npub1") else ""
    except OSError:
        return ""


def service_state():
    """systemd's word for nostr-vault.service: active, activating, inactive, failed, … or 'missing'."""
    if fp:
        return SUPERVISOR.state()
    try:
        r = subprocess.run(["systemctl", "is-active", "nostr-vault.service"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or "missing"
    except (OSError, subprocess.SubprocessError):
        return "missing"


def answers(port):
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=2).close()
        return True
    except urllib.error.HTTPError:
        return True  # anything answering HTTP is havend
    except Exception:  # noqa: BLE001 - connection refused, timeout: not up
        return False


def drive_choices():
    """Places the vault could live: real drives, most free space first."""
    seen, out = set(), []
    try:
        with open("/proc/mounts", encoding="utf-8") as f:
            mounts = [line.split() for line in f]
    except OSError:
        mounts = []
    skip = ("/boot", "/snap", "/run", "/dev", "/sys", "/proc", "/tmp", "/etc", "/var/lib/docker")
    for m in mounts:
        dev, mnt = m[0], m[1].replace("\\040", " ")
        fstype, opts = (m[2], m[3].split(",")) if len(m) > 3 else ("", [])
        if "ro" in opts or fstype in ("iso9660", "squashfs", "udf"):
            continue  # a CD, a snap or anything read-only can't hold a vault
        if not dev.startswith("/dev/") or any(mnt == s or mnt.startswith(s + "/") for s in skip) or dev in seen:
            continue
        seen.add(dev)
        try:
            du = shutil.disk_usage(mnt)
        except OSError:
            continue
        path = "/var/lib/nostr-vault" if mnt in ("/", "/var") else mnt.rstrip("/") + "/nostr-vault"
        out.append({"path": path, "free": du.free, "sd": dev.startswith("/dev/mmcblk")})
    out.sort(key=lambda d: -d["free"])
    return out


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.view = None
        self.indicator = None
        self.status_item = None
        self.env = read_env()
        self.page = None  # "vault", "setup" or "waiting": what the window shows
        self.pending_route = None
        self.setup_running = False
        self.root_running = 0  # run_root's pkexec runs still going (its failure notice needs this process)
        self.restart_timer = 0  # restart_as_tray's timer, while one runs (GLib source id)
        self.crashed = False  # the waiting page shows a crashed page: wait for Reload, don't reload by itself
        self.crash_page_at = None  # when the last crash page was loaded (time.monotonic())
        self.stopped = None  # the GTK crash page, in place of the web view, after a crash loop
        self.ticking = False  # a tick's checks are running on their thread
        self.checking = False  # show()/reopen()'s "does the vault answer?" is running on its thread
        self.has_paste = {}  # selection name -> True/False: something to paste there (PASTE_GUARD only)
        self.beat = time.monotonic()  # the main loop's heartbeat (the stall watchdog)
        self.watching = False  # the stall watchdog runs (from the first window)
        self.paste_watched = False  # the paste guard's clipboard handlers are connected (once, not per window)

    # ---- start-up

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.start_fault_log()
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        for name, keys, fn in (
            ("new-note", ["<Primary>n"], lambda *_: self.show("compose")),
            ("feed", ["<Primary>1"], lambda *_: self.show("feed")),
            ("vault", ["<Primary>2"], lambda *_: self.show("vault")),
            ("devices", ["<Primary>3"], lambda *_: self.show("devices")),
            ("settings", ["<Primary>comma"], lambda *_: self.show("settings")),
            ("reload", ["<Primary>r", "F5"], lambda *_: self.reload()),
            ("close", ["<Primary>w"], lambda *_: self.close_window()),
            ("quit", ["<Primary>q"], lambda *_: self.quit()),
        ):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", fn)
            self.add_action(act)
            self.set_accels_for_action("app." + name, keys)
        if fp:
            self.start_flatpak_vault()
        self.hold()  # the tray keeps the app alive with the window closed, as the Mac's menu bar item does
        self.make_tray()
        GLib.timeout_add_seconds(5, self.tick)

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if "--tray" in args:
            if self.indicator is None and not fp:  # no tray: show the window (a Flatpak runs on in the background)
                self.show(None)
            return 0
        route = None
        if "--open" in args:
            i = args.index("--open")
            route = args[i + 1] if i + 1 < len(args) else None
        self.show(route)
        return 0

    # ---- tray (the Mac's menu bar item)

    def make_tray(self):
        if Indicator is None:
            return
        menu = Gtk.Menu()
        self.status_item = Gtk.MenuItem(label="Checking the vault…")
        self.status_item.set_sensitive(False)
        menu.append(self.status_item)
        menu.append(Gtk.SeparatorMenuItem())
        for label, fn in (
            ("Open Nostr Vault", lambda *_: self.show(None)),
            ("New Note", lambda *_: self.show("compose")),
            (None, None),
            ("Feed", lambda *_: self.show("feed")),
            ("Vault", lambda *_: self.show("vault")),
            ("My Devices", lambda *_: self.show("devices")),
            ("Settings", lambda *_: self.show("settings")),
            (None, None),
            ("Copy box npub", lambda *_: self.copy_npub()),
            (None, None),
            ("Quit window and tray", lambda *_: self.quit()),
        ):
            item = Gtk.SeparatorMenuItem() if label is None else Gtk.MenuItem(label=label)
            if fn:
                item.connect("activate", fn)
            menu.append(item)
        menu.show_all()
        ind = Indicator.Indicator.new(APP_ID, TRAY_ICON, Indicator.IndicatorCategory.APPLICATION_STATUS)
        ind.set_title("Nostr Vault")
        ind.set_status(Indicator.IndicatorStatus.ACTIVE)
        ind.set_menu(menu)
        self.indicator = ind
        self.tick()

    def status_line(self, env):
        """The tray's status line. Runs on tick's thread: reads files and runs systemctl, touches no widget."""
        if not env.get("NV_OWNER"):
            return "Not set up yet"
        state = service_state()
        if state != "active":
            return {"activating": "Vault starting…", "failed": "Vault stopped (failed)",
                    "missing": "Vault not installed"}.get(state, "Vault stopped")
        mesh = mesh_status(env)
        n = mesh.get("devices")
        updated = mesh.get("updated")
        # nv-mesh writes its status every 5 s; an older one is from a mesh that stopped (as havend reads it).
        if not isinstance(updated, (int, float)) or abs(time.time() - updated) > 30:
            return "Vault running · mesh not running"
        if fp and not mesh:
            return "Vault running"  # the Flatpak has no mesh yet
        if mesh.get("error"):
            return "Vault running · mesh: " + str(mesh["error"])[:60]
        if isinstance(n, int):
            return f"Vault running · {n} device{'s' if n != 1 else ''} on the mesh"
        return "Vault running"

    def tick(self):
        """Every 5 s: the tray's status line, and leave the waiting page once the vault answers. The checks (a file
        read, systemctl, an HTTP request to the vault) run on a thread: on a busy machine each can take seconds, and
        the main loop must keep answering the compositor meanwhile."""
        if self.ticking:
            return True
        self.ticking = True
        want_answer = self.page == "waiting" and not self.crashed
        tray = self.status_item is not None

        def work():
            env = read_env()
            return env, (self.status_line(env) if tray else None), (want_answer and answers(vault_port(env)))

        def done(result):
            self.ticking = False
            env, line, up = result
            self.env = env
            if line is not None and self.status_item is not None:
                self.status_item.set_label(line)
            if up and self.page == "waiting" and not self.crashed:
                self.load_vault(self.pending_route)

        self.in_thread(work, done, (self.env, None, False))
        return True

    def in_thread(self, work, done, failed):
        """work() on a thread, then done(its result) on the main loop; done(failed) if work() raised (logged)."""
        def run():
            try:
                result = work()
            except Exception as e:  # noqa: BLE001 - logged; the window must keep running
                log("background check failed: " + repr(e))
                result = failed
            GLib.idle_add(lambda: (done(result), False)[1])

        threading.Thread(target=run, daemon=True).start()

    # ---- the stall watchdog (why a window was "not responding")

    def start_fault_log(self):
        try:
            path = log_path()
            os.makedirs(os.path.dirname(path), exist_ok=True)
            self.fault_file = open(path, "a", encoding="utf-8")  # noqa: SIM115 - open for the life of the process
            faulthandler.enable(self.fault_file)  # a crash in WebKit or GTK leaves the Python stack in window.log
        except OSError:
            pass

    def start_watchdog(self):
        """The stall watch, from the first window on (make_window): the tray alone, started at login, has no window
        to stall, and shouldn't wake 6 times a second for nothing."""
        if self.watching:
            return
        self.watching = True
        self.beat = time.monotonic()

        def heartbeat():
            self.beat = time.monotonic()
            return True

        GLib.timeout_add(250, heartbeat)
        main = threading.main_thread().ident

        def watch():
            reported = None
            while True:
                time.sleep(0.5)
                beat = self.beat
                late = time.monotonic() - beat
                if late >= STALL_S and reported != beat:
                    reported = beat
                    frame = sys._current_frames().get(main)
                    where = "".join(traceback.format_stack(frame, limit=8)).rstrip() if frame else "?"
                    # Python's stack ends in App.run when the main thread is inside GTK or WebKit, not in this file.
                    log(f"the main loop has been stalled for {late:.1f} s; main thread:\n{where}")
                elif reported is not None and reported != beat and late < STALL_S:
                    log(f"the main loop is running again (stalled for {beat - reported:.1f} s)")
                    reported = None

        threading.Thread(target=watch, daemon=True).start()

    def copy_npub(self):
        npub = box_npub(self.env)
        if not npub:
            self.notify("No box npub yet", "The mesh makes it on its first start.")
            return
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(npub, -1)
        self.notify("Box npub copied", "Add it on your phone: Profile › Mesh › My Devices › Add a device.")

    def notify(self, title, body):
        n = Gio.Notification.new(title)
        n.set_body(body)
        self.send_notification(None, n)

    # ---- window

    def make_window(self):
        self.stop_restart_timer()
        ctx = WebKit2.WebContext.new_with_website_data_manager(WebKit2.WebsiteDataManager(
            base_data_directory=os.path.join(GLib.get_user_data_dir(), "nostr-vault-desktop"),
            base_cache_directory=os.path.join(GLib.get_user_cache_dir(), "nostr-vault-desktop")))
        ucm = WebKit2.UserContentManager()
        ucm.register_script_message_handler("nv")
        ucm.connect("script-message-received::nv", self.on_message)
        view = WebKit2.WebView(web_context=ctx, user_content_manager=ucm)
        # Sign-ins survive a restart: cookies on disk, next to the web app's own storage.
        ctx.get_cookie_manager().set_persistent_storage(
            os.path.join(GLib.get_user_data_dir(), "nostr-vault-desktop", "cookies.sqlite"),
            WebKit2.CookiePersistentStorage.SQLITE)
        s = view.get_settings()
        s.set_enable_developer_extras(os.environ.get("NV_DESKTOP_DEBUG") == "1")
        s.set_javascript_can_access_clipboard(True)
        s.set_enable_write_console_messages_to_stdout(os.environ.get("NV_DESKTOP_DEBUG") == "1")
        s.set_user_agent_with_application_details(UA_MARK, "1")
        view.set_background_color(Gdk.RGBA(0, 0, 0, 1))
        view.connect("decide-policy", self.on_policy)
        view.connect("permission-request", self.on_permission)
        view.connect("create", self.on_create)
        view.connect("load-failed", self.on_load_failed)
        view.connect("web-process-terminated", self.on_web_process_terminated)
        if PASTE_GUARD:
            log("WebKitGTK %d.%d.%d crashes on a paste from an empty clipboard: pastes are checked first" % webkit_version())
            view.connect("key-press-event", self.on_key_press)
            view.connect("button-press-event", self.on_middle_click)
            view.connect("button-release-event", self.on_middle_click)
            view.connect("context-menu", self.on_context_menu)
            for name in ("CLIPBOARD", "PRIMARY"):
                cb = Gtk.Clipboard.get(Gdk.Atom.intern(name, False))
                if not self.paste_watched:  # the clipboards outlive a closed window: one handler each, ever
                    cb.connect("owner-change", lambda c, _e, n=name: self.check_paste(n, c))
                self.check_paste(name, cb)
            self.paste_watched = True

        win = Gtk.ApplicationWindow(application=self, title="Nostr Vault")
        win.set_default_size(1240, 860)  # the Mac window's first size
        # Small enough for a half-width tile (Hyprland, sway: ~628 px on a 1280 px screen); below 760 px the web app
        # draws its phone layout. 800x640 made a tiling WM squeeze the window instead (beta 9).
        win.set_size_request(360, 480)
        win.set_icon_name(ICON)
        win.add(view)
        win.connect("delete-event", lambda *_: (self.close_window(), True)[1])
        win.show_all()
        self.window, self.view = win, view
        self.start_watchdog()

    def close_window(self):
        """The window's close button and Ctrl+W. The window goes, and its web view with it, so WebKit's web process and
        network process end (a hidden window kept ~600 MB of them running on a laptop, 2026-11-25); the vault and the
        tray keep running, as on the Mac. Opening it again makes a new window, still signed in: cookies and the web
        app's storage are on disk. With no tray, close quits, except in a Flatpak, which keeps the vault running as a
        background app (opening the app shows it again)."""
        if self.window is None:
            return
        if self.indicator is None and not fp:
            self.quit()
            return
        win = self.window
        self.window = self.view = self.stopped = None
        self.page = None
        self.crashed = False
        self.crash_page_at = None
        win.destroy()
        GLib.idle_add(release_memory)
        if not fp:
            self.stop_restart_timer()  # close, open, close within 3 s: one timer, one count
            self.restart_tries = 0
            self.restart_timer = GLib.timeout_add_seconds(RESTART_AFTER_CLOSE_S, self.restart_as_tray)

    def stop_restart_timer(self):
        if self.restart_timer:
            GLib.source_remove(self.restart_timer)
            self.restart_timer = 0

    def restart_as_tray(self):
        """A while after the window closed: start over as the tray alone (exec, the same process id). With its window
        gone this process still holds the pages of the WebKit and GTK code that window ran (~160 MB on a laptop,
        2026-11-25); a tray that never opened a window holds ~50 MB. The tray icon goes and comes back. Not while a
        window is open again, and never in a Flatpak, whose process runs the vault. While setup or another pkexec
        runs, wait for it (its result needs this process) and then start over."""
        if self.window is not None or fp:
            self.restart_timer = 0
            return False
        if self.setup_running or self.root_running:
            return True
        # WebKit's helpers (and their bwrap sandboxes) end a moment after the window: wait for them, up to 30 s, so
        # none is left to end after the exec, when nothing would reap it (a zombie per window closed). Wait on every
        # child, not just those named WebKit: the sandbox's helpers (xdg-dbus-proxy) are this process's children too,
        # and waiting on WebKit and bwrap alone left one as a zombie (Ubuntu, Debian arm64; CI 2026-11-25). Nothing
        # else is a child by then: pkexec runs are waited for above, and the logs terminal is started detached.
        live, dead = children()
        self.restart_tries += 1
        if live and self.restart_tries < 10:
            return True
        self.restart_timer = 0
        for pid in dead:
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
        log("the window closed: starting over as the tray alone, to give back the window's memory")
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            os.execv(sys.executable, [sys.executable, "-I", os.path.abspath(sys.argv[0]), "--tray"])
        except OSError as e:
            log("couldn't start over as the tray: " + repr(e))
        return False

    def show(self, route):
        if self.window is None:
            self.make_window()
        self.env = read_env()
        if not self.env.get("NV_OWNER"):
            self.load_setup()
        elif self.page == "vault" and route:
            self.view.run_javascript(f"location.hash = {json.dumps(ROUTES.get(route, '#/feed'))}", None, None, None)
        elif self.page != "vault":
            self.open_vault_or_wait(route)
        self.window.present()

    def open_vault_or_wait(self, route):
        """The web app if the vault answers, else the waiting page. The HTTP check runs on a thread (it can take its
        full 2 s timeout on a busy machine), so the window stays responsive meanwhile."""
        self.pending_route = route
        if self.checking:
            return
        self.checking = True
        port = vault_port(self.env)

        def done(up):
            self.checking = False
            if self.window is None:
                return  # closed meanwhile
            if self.page == "vault":
                return  # something loaded it meanwhile
            if up:
                self.load_vault(self.pending_route)
            else:
                self.load_waiting(self.pending_route)

        self.in_thread(lambda: answers(port), done, False)

    def reload(self):
        """Ctrl+R and F5. On the crash pages (the web one and the GTK one) that is their Reload button: reloading the
        dead view would only reload the crash page, or nothing, with the GTK page in its place."""
        if self.page == "stopped" or (self.page == "waiting" and self.crashed):
            self.reopen()
        elif self.view is not None:
            self.view.reload()

    def origin(self):
        return f"http://127.0.0.1:{vault_port(self.env)}"

    def load_vault(self, route):
        self.use_view()
        self.page = "vault"
        self.crashed = False
        self.view.load_uri(self.origin() + "/" + ROUTES.get(route or "", ""))

    def load_local(self, name, state):
        """One of this app's own pages (setup, waiting), with its state handed in before its script runs."""
        self.use_view()
        with open(os.path.join(SHARE, name), encoding="utf-8") as f:
            # Inside an inline <script>: no "<" may survive, or a drive named "</script>…" writes the page.
            html = f.read().replace("/*NV_STATE*/null", json.dumps(state).replace("<", "\\u003c"))
        self.view.load_html(html, "nv-desktop://local/")

    def load_setup(self):
        self.page = "setup"
        self.crashed = False
        if fp:
            self.load_local("setup.html", {"page": "setup", "drives": fp.drives(), "setup": True})
            return
        self.load_local("setup.html", {"page": "setup", "drives": drive_choices(), "setup": os.access(SETUP, os.X_OK)})

    def load_waiting(self, route, crashed=False):
        self.page = "waiting"
        self.pending_route = route
        self.crashed = crashed
        if crashed:
            self.crash_page_at = time.monotonic()
        state = "crashed" if crashed else service_state()
        self.load_local("setup.html", {"page": "waiting", "state": state, "port": vault_port(self.env)})

    # ---- web view policies

    def on_policy(self, view, decision, kind):
        if kind != WebKit2.PolicyDecisionType.NAVIGATION_ACTION and kind != WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
            return False
        uri = decision.get_navigation_action().get_request().get_uri() or ""
        if uri.startswith(self.origin() + "/") or uri == self.origin() or uri.startswith(("about:", "nv-desktop:", "blob:")):
            if kind == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
                decision.ignore()
                view.load_uri(uri)
                return True
            return False
        # Anything else (a link to a website, a lightning: or nostr: link) goes to the system's own handler.
        decision.ignore()
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error:
            pass
        return True

    def on_create(self, view, action):
        uri = action.get_request().get_uri() or ""
        if uri:
            try:
                Gio.AppInfo.launch_default_for_uri(uri, None)
            except GLib.Error:
                pass
        return None

    def on_permission(self, view, req):
        # Notifications (new DMs, mentions) and the clipboard, for the vault's own pages only.
        ok = (WebKit2.NotificationPermissionRequest,)
        if hasattr(WebKit2, "ClipboardPermissionRequest"):
            ok += (WebKit2.ClipboardPermissionRequest,)
        if isinstance(req, ok) and (view.get_uri() or "").startswith(self.origin()):
            req.allow()
        else:
            req.deny()
        return True

    def on_load_failed(self, view, _event, uri, _err):
        if view is not self.view:
            return True  # a closed window's view, cancelled as it went
        if uri.startswith(self.origin()):
            self.load_waiting(None)
            return True
        return False

    def on_web_process_terminated(self, view, reason):
        # The page's renderer crashed or was killed: WebKit leaves a dead, empty view. Say so, with a Reload button.
        why = getattr(reason, "value_nick", reason)
        log(f"the page's web process ended ({why})")
        if view is not self.view:
            return  # a closed window's: nothing to show it in
        if self.crash_page_at is not None and time.monotonic() - self.crash_page_at < CRASH_LOOP_S:
            # It died again right after the last crash page: every page crashes. Loading another would start another
            # web process to die, so stop here until someone presses Reload.
            log(f"it ended again within {CRASH_LOOP_S} s of the last crash page; not loading another page")
            self.show_stopped()
            return
        self.load_waiting(self.pending_route, crashed=True)

    def show_stopped(self):
        """The crash page, drawn by GTK (no web process), in place of the web view."""
        self.page = "stopped"
        self.crashed = True
        if self.stopped is not None:
            return
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)
        title = Gtk.Label()
        title.set_markup("<span size='x-large' weight='bold'>The window stopped drawing</span>")
        body = Gtk.Label(label="Its page crashed again as soon as it came back, so the window has stopped loading it.\n"
                               "Your vault keeps running. You can open it in a browser at " + self.origin() + "/\n"
                               "If this keeps happening, quit Nostr Vault from its tray icon and open it again.")
        body.set_justify(Gtk.Justification.CENTER)
        body.set_line_wrap(True)
        button = Gtk.Button(label="Reload")
        button.set_halign(Gtk.Align.CENTER)
        button.connect("clicked", lambda *_: self.reopen())
        for w in (title, body, button):
            box.pack_start(w, False, False, 0)
        self.window.remove(self.view)
        self.window.add(box)
        box.show_all()
        self.stopped = box

    def use_view(self):
        """Put the web view back in the window if the GTK crash page took its place."""
        if self.stopped is None:
            return
        self.window.remove(self.stopped)
        self.stopped.destroy()
        self.stopped = None
        self.crash_page_at = None  # someone asked for a page again: a new crash gets the web crash page first
        self.window.add(self.view)
        self.view.show()

    def reopen(self):
        """Reload from the waiting page: the vault if it answers, else the waiting page again."""
        self.env = read_env()
        if not self.env.get("NV_OWNER"):
            self.load_setup()
        else:
            if self.page == "stopped":
                self.use_view()  # the web view back in the window now, so Reload visibly does something
                self.page = "waiting"
                self.crashed = False
            self.open_vault_or_wait(self.pending_route)

    # ---- the paste guard (PASTE_GUARD: WebKitGTK 2.54.0 and 2.54.1)

    def check_paste(self, name, clipboard):
        """Ask, without waiting, whether the selection has anything on it: a TARGETS request answered later on the
        main loop. GTK answers -1 bytes when there is no owner or it doesn't answer, which is the crash's case."""
        def got(_cb, data, _user):
            self.has_paste[name] = data is not None and data.get_length() > 0

        clipboard.request_contents(Gdk.Atom.intern("TARGETS", False), got, None)

    def nothing_to_paste(self, name):
        # Not known yet (the first answer hasn't come): treat it as empty. Losing one paste right after the window
        # opens is better than the crash.
        return not self.has_paste.get(name, False)

    def on_key_press(self, _view, event):
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
                              | Gdk.ModifierType.MOD1_MASK | Gdk.ModifierType.SUPER_MASK)
        key = Gdk.keyval_to_lower(event.keyval)
        ctrl, shift = Gdk.ModifierType.CONTROL_MASK, Gdk.ModifierType.SHIFT_MASK
        # By keyval, and by the physical key: on a two-layout keyboard (ru,us or el,us) the V key gives another
        # letter, and GTK's bindings can still take Ctrl+that key as Ctrl+V.
        code = event.hardware_keycode
        paste = ((key == Gdk.KEY_v or code in keycodes_of(Gdk.KEY_v)) and mods in (ctrl, ctrl | shift)) or \
                ((key in (Gdk.KEY_Insert, Gdk.KEY_KP_Insert) or code in keycodes_of(Gdk.KEY_Insert, Gdk.KEY_KP_Insert))
                 and mods == shift)
        if paste and self.nothing_to_paste("CLIPBOARD"):
            log("a paste with an empty clipboard was kept from WebKit (it would crash the window)")
            return True
        return False

    def on_middle_click(self, _view, event):
        # WebKit pastes the primary selection on a middle click's release in a text field. Every middle click is
        # kept while the selection is empty, not only one over a text field: the hover hint that said so came late or
        # not at all (a field opening under a pointer that hasn't moved), and a lost middle click costs nothing.
        if event.button == 2 and self.nothing_to_paste("PRIMARY"):
            if event.type == Gdk.EventType.BUTTON_RELEASE:
                log("a middle-click paste with an empty selection was kept from WebKit (it would crash the window)")
            return True
        return False

    def on_context_menu(self, _view, menu, _event, _hit):
        if self.nothing_to_paste("CLIPBOARD"):
            paste = {getattr(WebKit2.ContextMenuAction, a) for a in ("PASTE", "PASTE_AS_PLAIN_TEXT")
                     if hasattr(WebKit2.ContextMenuAction, a)}
            for item in list(menu.get_items()):
                if item.get_stock_action() in paste:
                    menu.remove(item)
        return False

    # ---- the local pages' messages

    def on_message(self, _ucm, result):
        try:
            value = result.get_js_value() if hasattr(result, "get_js_value") else result
            msg = json.loads(value.to_string())
        except (ValueError, AttributeError):
            return
        # Only this app's own pages (setup, waiting) may ask for these: never the vault's web app or anything it loads.
        if not isinstance(msg, dict) or self.page not in ("setup", "waiting") \
                or not (self.view.get_uri() or "").startswith("nv-desktop://local/"):
            return
        what = msg.get("do")
        if what == "reload" and self.page == "waiting":
            self.reopen()
            return
        if fp:
            self.on_flatpak_message(what, msg)
            return
        if what == "setup" and self.page == "setup" and not self.setup_running:
            self.run_setup(str(msg.get("owner", "")), str(msg.get("data", "")), bool(msg.get("sdOk")), bool(msg.get("newOk")))
        elif what == "start":
            self.run_root(["systemctl", "start", "nostr-vault.service"], "Couldn't start the vault")
        elif what == "logs":
            # Through sh's "&", so the terminal isn't this process's child: it can stay open for hours, past the
            # window and restart_as_tray's exec, after which nothing here would reap it.
            if shutil.which("x-terminal-emulator"):
                subprocess.run(["sh", "-c", 'x-terminal-emulator -e journalctl -fu nostr-vault -u nostr-vault-mesh &'],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ---- Flatpak: the window runs the vault (nv_flatpak.py)

    def start_flatpak_vault(self):
        self.env = read_env()
        if self.env.get("NV_OWNER"):
            SUPERVISOR.start(self.env)
            fp.request_background()

    def on_flatpak_message(self, what, msg):
        if what == "setup" and self.page == "setup":
            ok, text = fp.setup(str(msg.get("owner", "")), read_env())
            self.setup_done(ok, text)
            if ok:
                self.start_flatpak_vault()
        elif what == "start":
            self.start_flatpak_vault()
        elif what == "logs":
            try:
                Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(fp.log_file(), None), None)
            except GLib.Error:
                pass

    def do_shutdown(self):
        if fp:
            SUPERVISOR.stop()
        Gtk.Application.do_shutdown(self)

    def js(self, fn, arg):
        if self.view is None:
            return  # the window was closed
        self.view.run_javascript(f"window.{fn} && window.{fn}({json.dumps(arg)})", None, None, None)

    def run_setup(self, owner, data, sd_ok, new_ok):
        argv = ["pkexec", SETUP, "--owner", owner, "--data", data]
        if sd_ok:
            argv.append("--sd-ok")
        if new_ok:
            argv.append("--new-ok")
        self.setup_running = True
        self.spawn(argv, self.setup_done)

    def setup_done(self, ok, out):
        self.setup_running = False
        if ok:
            self.env = read_env()
            self.js("nvSetupResult", {"ok": True, "text": out.strip().splitlines()[-1] if out.strip() else ""})
            GLib.timeout_add(900, lambda: (self.view is not None and self.load_vault(None), False)[1])
        else:
            text = out.strip().splitlines()[-1] if out.strip() else "Setup was cancelled."
            self.js("nvSetupResult", {"ok": False, "text": text.replace("nostr-vault-setup: ", "")})

    def run_root(self, argv, failed):
        def done(ok, out):
            self.root_running -= 1
            if not ok:
                self.notify(failed, out.strip()[-200:])
        self.root_running += 1
        self.spawn(["pkexec"] + argv, done)

    def spawn(self, argv, done):
        try:
            p = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            done(False, e.message)
            return

        def finished(proc, res):
            try:
                _ok, out, _err = proc.communicate_utf8_finish(res)
            except GLib.Error as e:
                done(False, e.message)
                return
            done(proc.get_successful(), out or "")

        p.communicate_utf8_async(None, None, finished)


def children():
    """This process's children: (still running, ended and not yet reaped), as process ids."""
    live, dead = [], []
    me = str(os.getpid())
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/stat") as f:
                fields = f.read().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        if fields[1] == me:
            (dead if fields[0] == "Z" else live).append(int(pid))
    return live, dead


def release_memory():
    """After a window closes: free its Python objects now, and give the freed heap back to the system (glibc keeps it
    otherwise, and the tray would go on showing the closed window's size)."""
    gc.collect()
    try:
        ctypes.CDLL("libc.so.6").malloc_trim(0)
    except (OSError, AttributeError):
        pass  # not glibc (musl has no malloc_trim)
    return False


def main():
    if not Gtk.init_check()[0]:
        print("nostr-vault-desktop: no display. The vault runs anyway; open http://<this machine>:8080/ "
              "from a phone or computer on your network.", file=sys.stderr)
        return 1
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
